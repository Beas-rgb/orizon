{
  "name": "horizon-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build",
    "build:pages": "node scripts/build_pages.mjs",
    "publish:app": "node scripts/publish_app.mjs",
    "lint": "oxlint && npm run checar:hex",
    "checar:hex": "node scripts/checar_hex.mjs",
    "test": "vitest run",
    "test:v7": "vitest run tests/v7",
    "test:v7:hashes": "node tests/v7/conferir-hashes.mjs",
    "test:v7:visual": "playwright test --project=celular --project=desktop",
    "calibrar:v7": "playwright test --project=calibracao",
    "gerar:tokens:v7": "node scripts/v7/gerar-tokens.mjs",
    "varredura:v7": "node scripts/v7/varredura.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/montserrat": "^5.2.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.81.0",
    "pngjs": "7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
