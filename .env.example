# Copie para .env e preencha. O .env real não entra no git.
# Formato SQLAlchemy + psycopg (driver explícito):
# postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

APP_ENV=development

# Placeholders das fases seguintes. Ainda não são lidos pelo código da Fase 0.
JWT_SECRET=troque-por-um-segredo-longo-de-pelo-menos-32-caracteres

# Força bruta no banco: 3 erros, depois espera 5 minutos.
LOGIN_MAX_TENTATIVAS=3
LOGIN_ESPERA_MINUTOS=5

# Endereço da tela. O e-mail leva um link para cá.
APP_PUBLIC_URL=http://127.0.0.1:8000/app

# Origens permitidas a chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Preencha no .env, não no chat. Sem isto o convite fica em data/outbox/ultimo.txt
# Gmail: smtp.gmail.com, porta 587, senha de app, SMTP_FROM igual ao SMTP_USER
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
